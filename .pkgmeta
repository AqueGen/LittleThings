package-as: LittleThings

enable-nolib-creation: no

manual-changelog:
  filename: RELEASE_NOTES.md
  markup-type: markdown

# No externals. The only library is LibVelvet-1.0, our own settings-window look,
# kept as a copy in Libs/ (refreshed with Velvet's tools/sync.ps1), not fetched at
# package time.

ignore:
  - README.md
  - RELEASE_NOTES.md
  - .gitignore
  - .github
  - .busted
  - .superpowers
  - tools
  - CLAUDE.md
  # AGENTS.md is deliberately NOT ignored: the notice only does its job where
  # an agent actually reads the addon, which is the installed folder.
  - docs
  - tests
  - release-please-config.json
  - .release-please-manifest.json
